# Settings for compose.prod.yaml. Copy to .env, fill in, and never commit .env.

# Public address of the site, with https.
APP_URL=https://pds.example.com
# Port on the host that the reverse proxy forwards to (bound to 127.0.0.1 only).
APP_PORT=8080

# Database password for the pdsync user (any long random string).
DB_PASS=
# Key that encrypts stored PDS: 32 random bytes, base64. Create one with
#   php -r "echo base64_encode(random_bytes(32));"   or   openssl rand -base64 32
# Back it up; without it stored PDS cannot be opened.
DATA_KEY=

# Google sign-in (optional). Redirect URI: <APP_URL>/auth.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts that may open /admin.php, comma-separated.
ADMIN_EMAILS=

# Shown on the privacy notice (Data Privacy Act).
CONTACT_EMAIL=
DPO_NAME=
DPO_EMAIL=
TIMEZONE=Asia/Manila
