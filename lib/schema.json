  {
    "id": "questions",
    "title": "Questions 34-40",
    "fields": [
      {"k": "q34a", "l": "a. within the third degree?", "t": "yn", "w": 4, "g": "Question 34", "gd": "Are you related by consanguinity or affinity to the appointing or recommending authority, or to the chief of bureau or office, or to the person who has immediate supervision over you in the office, bureau or department where you will be appointed:"},
      {"k": "q34a_details", "l": "If YES, give details", "w": 4, "if": ["q34a", "Yes"]},
      {"k": "q34b", "l": "b. within the fourth degree (for Local Government Unit - Career Employees)?", "t": "yn", "w": 4},
      {"k": "q34b_details", "l": "If YES, give details", "w": 4, "if": ["q34b", "Yes"]},
      {"k": "q35a", "l": "a. Have you ever been found guilty of any administrative offense?", "t": "yn", "w": 4, "g": "Question 35"},
      {"k": "q35a_details", "l": "If YES, give details", "w": 4, "if": ["q35a", "Yes"]},
      {"k": "q35b", "l": "b. Have you been criminally charged before any court?", "t": "yn", "w": 4},
      {"k": "q35b_details", "l": "If YES, give details", "w": 4, "if": ["q35b", "Yes"]},
      {"k": "q35b_date", "l": "Date filed", "t": "date", "w": 2, "if": ["q35b", "Yes"]},
      {"k": "q35b_status", "l": "Status of case/s", "w": 2, "if": ["q35b", "Yes"]},
      {"k": "q36", "l": "Have you ever been convicted of any crime or violation of any law, decree, ordinance or regulation by any court or tribunal?", "t": "yn", "w": 4, "g": "Question 36"},
      {"k": "q36_details", "l": "If YES, give details", "w": 4, "if": ["q36", "Yes"]},
      {"k": "q37", "l": "Have you ever been separated from the service in any of the following modes: resignation, retirement, dropped from the rolls, dismissal, termination, end of term, finished contract or phased out (abolition) in the public or private sector?", "t": "yn", "w": 4, "g": "Question 37"},
      {"k": "q37_details", "l": "If YES, give details", "w": 4, "if": ["q37", "Yes"]},
      {"k": "q38a", "l": "a. Have you ever been a candidate in a national or local election held within the last year (except Barangay election)?", "t": "yn", "w": 4, "g": "Question 38"},
      {"k": "q38a_details", "l": "If YES, give details", "w": 4, "if": ["q38a", "Yes"]},
      {"k": "q38b", "l": "b. Have you resigned from the government service during the three (3)-month period before the last election to promote/actively campaign for a national or local candidate?", "t": "yn", "w": 4},
      {"k": "q38b_details", "l": "If YES, give details", "w": 4, "if": ["q38b", "Yes"]},
      {"k": "q39", "l": "Have you acquired the status of an immigrant or permanent resident of another country?", "t": "yn", "w": 4, "g": "Question 39"},
      {"k": "q39_details", "l": "If YES, give details (country)", "w": 4, "if": ["q39", "Yes"]},
      {"k": "q40a", "l": "a. Are you a member of any indigenous group?", "t": "yn", "w": 4, "g": "Question 40", "gd": "Pursuant to: (a) Indigenous People's Act (RA 8371); (b) Magna Carta for Disabled Persons (RA 7277, as amended); and (c) Expanded Solo Parents Welfare Act (RA 11861), please answer the following items:"},
      {"k": "q40a_details", "l": "If YES, please specify", "w": 4, "if": ["q40a", "Yes"]},
      {"k": "q40b", "l": "b. Are you a person with disability?", "t": "yn", "w": 4},
      {"k": "q40b_details", "l": "If YES, please specify ID No.", "w": 4, "if": ["q40b", "Yes"]},
      {"k": "q40c", "l": "c. Are you a solo parent?", "t": "yn", "w": 4},
      {"k": "q40c_details", "l": "If YES, please specify ID No.", "w": 4, "if": ["q40c", "Yes"]}
    ]
